; Engine configuration file.
; Godot 4 port of Run Hero Run (originally libGDX, "Compress").

config_version=5

[application]

config/name="Run Hero Run"
config/description="Godot port of Run Hero Run (2015, libGDX)."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4")

[autoload]

Assets="*res://scripts/assets.gd"

[display]

window/size/viewport_width=204
window/size/viewport_height=136
window/size/window_width_override=1020
window/size/window_height_override=680
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=0

[input_devices]

pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=60

[rendering]

textures/canvas_textures/default_texture_filter=3
environment/defaults/default_clear_color=Color(1, 1, 1, 1)
